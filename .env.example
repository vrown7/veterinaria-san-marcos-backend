# Copiar como .env y completar. El archivo .env NO se sube a GitHub.
PORT=3000

# Base de datos PostgreSQL (endpoint de RDS)
DB_HOST=
DB_PORT=5432
DB_NAME=veterinaria
DB_USER=postgres
DB_PASSWORD=
# true para RDS; false solo para una base local de pruebas
DB_SSL=true

# JWT
JWT_SECRET=
JWT_EXPIRA=1h
JWT_EMISOR=veterinaria-san-marcos-api
JWT_DESTINATARIO=veterinaria-san-marcos-web

# Orígenes del frontend permitidos por CORS, separados por coma
# (ej. http://localhost:5173,http://IP_PUBLICA_EC2:5173)
CORS_ORIGEN=http://localhost:5173,http://IP_PUBLICA_EC2:5173

# Administrador inicial que crea "npm run db:init"
ADMIN_CORREO=
ADMIN_CLAVE=
